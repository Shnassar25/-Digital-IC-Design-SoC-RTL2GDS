//shahd mahmoud
//Test Bench
`timescale 1ns/1ps

module SYS_TOP_TB;

    // Parameters
    parameter WIDTH_tb     = 8;
    parameter ADDR_tb      = 4;
    parameter NO_OF_REG_tb = 2 * WIDTH_tb;

    //=========================== Timing Parameters ===========================
    // UART_CLK period unit = BIT_TIME (ns) so keep integers
    parameter integer BIT_TIME   = 271;                     // UART_CLK half-period * 2 = 271ns per full UART_CLK cycle
    parameter integer PRESCALE   = 32;                      // Must match design prescale used by UART
    parameter integer BIT_PERIOD = PRESCALE * BIT_TIME;     // Bit time = prescale * UART_CLK period
    parameter integer REF_PERIOD = 20;                      // 50 MHz ref clock => 20 ns

    //=========================== Command Localparams ===========================
    localparam CMD_WR_REG  = 8'hAA;
    localparam CMD_RD_REG  = 8'hBB;
    localparam CMD_ALU_OP  = 8'hCC;
    localparam CMD_ALU_NOP = 8'hDD; 

    // Testbench Signals
    reg                  REF_CLK_tb;
    reg                  UART_CLK_tb;
    reg                  RST_tb;
    reg                  RX_IN_tb;
    
    wire                 TX_OUT_tb;
    wire                 PAR_ERR_tb;
    wire                 STOP_ERR_tb;

    // Variables for checking received data
    reg [WIDTH_tb-1:0]   received_data;
    integer              error_count = 0;

   
    // Instantiate Top Module
    SYS_TOP #(
        .WIDTH(WIDTH_tb),
        .ADDR(ADDR_tb),
        .NO_OF_REG(NO_OF_REG_tb)
    ) SYS_TOP_tb (
        .REF_CLK(REF_CLK_tb),
        .UART_CLK(UART_CLK_tb),
        .RST(RST_tb),
        .RX_IN(RX_IN_tb),
        .TX_OUT(TX_OUT_tb),
        .PAR_ERR(PAR_ERR_tb),
        .STOP_ERR(STOP_ERR_tb)
    );

//=========================== Clock Generators ===========================
   
    always #(REF_PERIOD / 2) REF_CLK_tb = ~REF_CLK_tb; // 50 MHz

    always #(BIT_TIME / 2) UART_CLK_tb = ~UART_CLK_tb;  // 3.6864 MHz

//=========================== Monitor for protocol errors ===========================
    initial begin
        $monitor("[%0t] MONITOR: PAR_ERR = %b | STOP_ERR = %b | RST = %b", 
                 $time, PAR_ERR_tb, STOP_ERR_tb, RST_tb);
    end
    
//================================= Tasks ================================

// Task for initial signal states at simulation start
task intialization;
    begin
        REF_CLK_tb       = 0;
        UART_CLK_tb      = 0;
        RX_IN_tb         = 1'b1;
        error_count      = 0;
        $display("[%0t] SYSTEM: Initial inputs applied.", $time);
    end
endtask
    
task reset_system;
    begin
        RST_tb   = 1'b0; 
        RX_IN_tb = 1'b1;
        #(REF_PERIOD * 10);
        RST_tb   = 1'b1;
        @(posedge REF_CLK_tb);
        $display("[%0t] SYSTEM: Reset Applied and Released.", $time);
    end
endtask

// Task to send a byte serially UART RX synchronized with UART_CLK cycles
task uart_send_byte(
    input [WIDTH_tb-1:0] data_in
);
integer i;

    begin
        
        RX_IN_tb = 'b1;
       #(BIT_PERIOD*2);

        // 1. Start Bit (0) - lasting 16 UART clock cycles
        RX_IN_tb = 1'b0;
         #(BIT_PERIOD);

        // 2. Data Bits (LSB first)
        for (i = 0; i < WIDTH_tb; i = i + 1) begin
            RX_IN_tb = data_in[i];
            #(BIT_PERIOD);
        end

        // 4. Stop Bit (1)
        RX_IN_tb = 1'b1;
        #(BIT_PERIOD*2);
    end
endtask

// Task to capture a byte coming out of UART TX
task uart_receive_byte(
    output [WIDTH_tb-1:0] data_out
);
integer i;
    begin
        // Wait for Start Bit (falling edge on TX_OUT)
        @(negedge TX_OUT_tb);
        // wait half bit to sample in middle of first data bit
        #(BIT_PERIOD*1.5);

        // sample 8 data bits, LSB first
        for (i = 0; i < WIDTH_tb; i = i + 1) begin
            data_out[i] = TX_OUT_tb;
            #(BIT_PERIOD);
        end
        // Wait for stop bit sampling
        #(BIT_PERIOD);
        $display("[%0t] UART RX CHECK: Captured Byte = 0x%h (%0d)", $time, data_out, data_out);
    end
endtask

// Task: Write to Register File
task write_reg(
    input [WIDTH_tb-1:0] address, 
    input [WIDTH_tb-1:0] data
);
    begin
        $display("[%0t] -> [WRITE REG] Addr: 0x%h | Data: 0x%h", $time, address, data);
        uart_send_byte(CMD_WR_REG); 
        uart_send_byte(address);    
        uart_send_byte(data);       
        #(BIT_PERIOD * 5);
    end
endtask

// Task: Read from Register File & Verify Output
task read_reg_and_check(
    input [WIDTH_tb-1:0] address,
    input [WIDTH_tb-1:0] expected_data
);
    begin
        $display("[%0t] -> [READ REG] Requesting Addr: 0x%h (Expected: 0x%h)", $time, address, expected_data);
        uart_send_byte(CMD_RD_REG); 
        uart_send_byte(address);    
            
        // Capture the response from TX
        uart_receive_byte(received_data);
        
        if (received_data === expected_data) begin
            $display("[%0t] [PASS] Read match! Got 0x%h as expected.", $time, received_data);
        end else begin
            $display("[%0t] [FAIL] Read mismatch! Got 0x%h, Expected 0x%h", $time, received_data, expected_data);
            error_count = error_count + 1;
        end
        #(BIT_PERIOD * 5);
    end
endtask

// Task: Execute ALU Operation & Verify Output
task execute_alu_and_check(
    input [WIDTH_tb-1:0] op_a, 
    input [WIDTH_tb-1:0] op_b, 
    input [WIDTH_tb-1:0] alu_fun, 
    input [WIDTH_tb-1:0] expected_result
);
    begin
        $display("[%0t] -> [ALU OP] OpA: 0x%h, OpB: 0x%h, Fun: 0x%h (Expected Res: 0x%h)", $time, op_a, op_b, alu_fun, expected_result);
        uart_send_byte(CMD_ALU_OP); 
        uart_send_byte(op_a);       
        uart_send_byte(op_b);       
        uart_send_byte(alu_fun);    
            
        // Capture the response from TX (ALU results are transmitted back)
        uart_receive_byte(received_data);

        if (received_data === expected_result) begin
            $display("[%0t] [PASS] ALU result match! Got 0x%h as expected.", $time, received_data);
        end else begin
            $display("[%0t] [FAIL] ALU result mismatch! Got 0x%h, Expected 0x%h", $time, received_data, expected_result);
            error_count = error_count + 1;
        end
        #(BIT_PERIOD * 10);         
    end
endtask

// Task: Execute ALU NOP Command
task execute_alu_nop(
    input [WIDTH_tb-1:0] alu_fun
);
    begin
        $display("[%0t] -> [ALU NOP] Executing NOP command", $time);
        uart_send_byte(CMD_ALU_NOP); 
        uart_send_byte(alu_fun); 
        #(BIT_PERIOD * 5);         
    end
endtask

//=========================== INTIAL BLOCK ===========================
    initial begin
        // Call the initial 
        intialization();

        // 1. System Reset
        reset_system();

        // 2. Initial Configuration Phase (Addresses 0x2 & 0x3)
        $display("\n--- PHASE 1: CONFIGURATION ---");
       // write_reg(8'h02, 8'h81); // UART Config Reg 100000_01 
        //write_reg(8'h03, 8'h20); // Div Ratio Reg 00100000

        // 3. Normal Register Operations (Addresses 0x4 to 0x15) - Multiple Tests
        $display("\n--- PHASE 2: REGISTER FILE WRITE & READ TESTS ---");
        write_reg(8'h04, 8'h55); // Write 0x55 to reg 0x4
        write_reg(8'h05, 8'hAA); // Write 0xAA to reg 0x5
        write_reg(8'h06, 8'h3F); // Write 0x3F to reg 0x6

        // Read back and verify using task check
        read_reg_and_check(8'h04, 8'h55);
        read_reg_and_check(8'h05, 8'hAA);
        read_reg_and_check(8'h06, 8'h3F);

        // 4. ALU Operations - Multiple Test Cases with Checking
        $display("\n--- PHASE 3: ALU OPERATIONS & VERIFICATION ---");
        // Test Case A: Addition 
        execute_alu_and_check(8'h10, 8'h05, 8'h00, 8'h15);

        // Test Case B: Subtraction
        execute_alu_and_check(8'h20, 8'h05, 8'h01, 8'h1B);

        // Test Case C: Bitwise AND
        execute_alu_and_check(8'hF0, 8'h0F, 8'h02, 8'h00);

        // Test Case D: ALU NOP
        execute_alu_nop(8'h03);

        // Final Report
        #1000;
        $display("\n========================================");
        if (error_count == 0) begin
            $display("ALL TESTS PASSED SUCCESSFULLY! No errors detected.");
        end else begin
            $display("SIMULATION FINISHED WITH %0d ERRORS.", error_count);
        end
        $display("========================================\n");
        $finish;
    end
endmodule



