current_design  "SYS_TOP"

########################################################################
#Section 1: List of source clocks
#These clocks have set_false_path/set_clock_groups/set_clock_uncertainty associated with them
#../../syn/sdc/SYS_TOP.sdc@@14@@
clock  -name "REF_CLK"  -domain d0  -edge { "0.000000" "10.000000"}  -period 20 -tag REF_CLK 
#../../syn/sdc/SYS_TOP.sdc@@22@@
clock  -name "UART_CLK"  -domain d1  -edge { "0.000000" "135.645004"}  -period 271.290009 -tag UART_CLK 

