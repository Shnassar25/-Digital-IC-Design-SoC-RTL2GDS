########################################################################
#Section 6: List of valid abstract_port/input constraint generated from set_input_delay command.
#../../syn/sdc/SYS_TOP.sdc@@39@@
abstract_port -ports "RX_IN" -clock "UART_CLK"

########################################################################
#Section 7: List of valid output constraint generated from set_output_delay command.
#../../syn/sdc/SYS_TOP.sdc@@40@@
output  -name "TX_OUT"  -clock "UART_CLK"
#../../syn/sdc/SYS_TOP.sdc@@41@@
output  -name "PAR_ERR"  -clock "UART_CLK"
#../../syn/sdc/SYS_TOP.sdc@@42@@
output  -name "STOP_ERR"  -clock "UART_CLK"

